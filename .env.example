# ------------------------------------------------------------------
# GCA sneakers — variables d'environnement (copier en .env)
# ------------------------------------------------------------------
# URL du projet Supabase : Project Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé PUBLIQUE (publishable / anon) : Project Settings → API Keys.
# ⚠️ Ne JAMAIS mettre la clé service_role / secret ici : tout ce qui
#    commence par VITE_ est visible dans le navigateur.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# URL publique du site (sitemap, balises canonical / Open Graph)
VITE_SITE_URL=https://gca-sneakers.vercel.app
